# LLM-as-a-judge 평가에 필요합니다. 실제 키는 .env.local에만 저장하세요.
OPENAI_API_KEY=""

# RAG 대상 답변 모델과 임베딩 모델입니다.
RAG_MODEL="gpt-4.1-mini"
RAG_EMBEDDING_MODEL="text-embedding-3-small"
# 평가 judge 모델입니다. 비우면 RAG_MODEL을 사용합니다.
RAG_JUDGE_MODEL=""

# DeepEval/Confident AI 대시보드 연동은 선택 사항입니다.
CONFIDENT_TRACE_FLUSH=1
# CONFIDENT_API_KEY=""

# LangWatch 평가 실행 시 필요합니다.
LANGWATCH_API_KEY=""
LANGWATCH_ENDPOINT_URL="http://localhost:5560"
